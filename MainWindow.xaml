<Window x:Class="GoldenLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldenLight"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Goldenlight - Reviving the old Web" Height="450" Width="800">
    <Window.Resources>
        <Storyboard x:Key="PlayButtonStoryBoard">
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="00:00:00.2000000" Value="sc#1, 0.407240242, 0.407240242, 0.407240242"/>
                <EasingColorKeyFrame KeyTime="00:00:00.5000000" Value="#FF929292"/>
                <EasingColorKeyFrame KeyTime="00:00:01" Value="#FFDDDDDD"/>
            </ColorAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(Control.Foreground).(SolidColorBrush.Color)">
                <EasingColorKeyFrame KeyTime="00:00:00.2000000" Value="Black"/>
                <EasingColorKeyFrame KeyTime="00:00:00.5330000" Value="#FF213799"/>
                <EasingColorKeyFrame KeyTime="00:00:00.7000000" Value="Black"/>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.9000000" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="0.5"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.9000000" Value="1"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PlayBtn" Storyboard.TargetProperty="(Control.FontSize)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="72"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="48"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.5000000" Value="72"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="18"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="82*"/>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="293*"/>
            <RowDefinition Height="18*"/>
        </Grid.RowDefinitions>
        <Frame Source="/HeaderPage.xaml" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom" Text="&#xE730;" FontFamily="Segoe Fluent Icons" Grid.Row="1" Height="12" Background="{DynamicResource WarningColor}"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Goldenlight apps have full device access." VerticalAlignment="Center" LineHeight="6" Width="770" Grid.Column="1" Height="18" Grid.Row="1" FontFamily="Segoe UI Variable Small" Background="{DynamicResource WarningColor}"/>
        <TextBox x:Name="UrlBox" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="18" Grid.ColumnSpan="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" CaretBrush="#FF262626" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" SelectionTextBrush="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Margin="3,0,10,0" >
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button Style="{DynamicResource PlayButtonStyle}" x:Name="PlayBtn" Content="&#xE768;" Margin="3,3,10,0" Grid.Row="3" VerticalAlignment="Top" Height="280" FontFamily="Segoe Fluent Icons" FontSize="72" Click="PlayBtn_Click" Grid.ColumnSpan="2" Background="#FFDDDDDD" Foreground="Black" RenderTransformOrigin="0.5,0.5">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseEnter">
                    <b:ControlStoryboardAction Storyboard="{StaticResource PlayButtonStoryBoard}" ControlStoryboardOption="Play"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </Button>
    </Grid>
</Window>
