<Window x:Class="GoldenLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldenLight" xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Goldenlight - Reviving the old Web" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="18"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="82*"/>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="293*"/>
            <RowDefinition Height="18*"/>
        </Grid.RowDefinitions>
        <Frame Source="/HeaderPage.xaml" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" TextWrapping="Wrap" VerticalAlignment="Bottom" Text="&#xE730;" FontFamily="Segoe Fluent Icons" Grid.Row="1" Height="12" Background="{DynamicResource WarningColor}"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="Goldenlight apps have full device access." VerticalAlignment="Center" LineHeight="6" Width="770" Grid.Column="1" Height="18" Grid.Row="1" FontFamily="Segoe UI Variable Small" Background="{DynamicResource WarningColor}"/>
        <TextBox x:Name="UrlBox" Grid.Row="2" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Height="18" Grid.ColumnSpan="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkDarkBrushKey}}" CaretBrush="#FF262626" Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}" SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" SelectionTextBrush="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" Margin="3,0,10,0" >
            <TextBox.Effect>
                <DropShadowEffect/>
            </TextBox.Effect>
        </TextBox>
        <Button x:Name="PlayBtn" Content="&#xE768;" Margin="3,3,10,0" Grid.Row="3" VerticalAlignment="Top" Height="280" FontFamily="Segoe Fluent Icons" FontSize="72" Click="PlayBtn_Click" Grid.ColumnSpan="2">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>


    </Grid>
</Window>
